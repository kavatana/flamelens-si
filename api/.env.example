# Postgres connection string. Local development: a database named "flamelens".
# Production: the pooled connection string from Neon.
DATABASE_URL=postgres://localhost:5432/flamelens

# The port the API listens on. Where the host sets PORT instead, leave this out.
API_PORT=4000

# The live SI. Optional: without any of these the API still answers, from prepared
# answers whose lookups run live.
#
# Through Amazon Bedrock (used when set): a Bedrock API key, the region and the
# model. (An access key with its secret works for Claude models only.)
BEDROCK_API_KEY=
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=us-east-1
# gpt-oss-120b: the lowest-cost model that kept to the lookups in our tests, at
# under a tenth of a cent per question. If the account has no access to it, the
# fallback is used. Any chat model on Bedrock can be named; a Claude model
# (anthropic.claude-...) needs an account with access to Claude on Bedrock.
BEDROCK_MODEL=openai.gpt-oss-120b
BEDROCK_MODEL_FALLBACK=moonshotai.kimi-k2.5

# Or through Anthropic's own API (used when no Bedrock setting is there).
ANTHROPIC_API_KEY=

# Model used for live answers, and the daily spend cap in US dollars.
# claude-opus-5-5 is the default (about 3 to 8 cents per question).
# claude-haiku-5-5 costs roughly 40 times less, with simpler answers.
ANTHROPIC_MODEL=claude-opus-5-5
SI_DAILY_BUDGET_USD=2

# Reading answers aloud with ElevenLabs. Optional: without the key the Listen
# button uses the voice built into the visitor's browser.
# The key needs the Text to Speech permission. The voice and the model have
# defaults (the voice River, the model eleven_flash_v2_5).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
VOICE_DAILY_CHARACTERS=30000

# Hourly limits, as "visitor,address,minute": one visitor in an hour, one address in an
# hour, everyone together in a minute. The usual values are shown. When the site is shown
# to a room of people on one connection, raise the second number: they share one address.
# ASK_LIMITS=12,60,30
# SPEAK_LIMITS=20,80,40
