{
  "name": "@flamelens/api",
  "version": "1.0.0",
  "private": true,
  "description": "The FlameLens API: the database, the queries the pages are built from, the export and the SI.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.2",
    "@anthropic-ai/sdk": "^1.8.0",
    "@flamelens/shared": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "postgres": "^4.1.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
